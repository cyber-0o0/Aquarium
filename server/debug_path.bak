"""Quick debug: what does httpx actually send for ../users/me?"""
import asyncio
from httpx import AsyncClient, ASGITransport
from fastapi import FastAPI, Request

debug_app = FastAPI()

@debug_app.middleware("http")
async def dump_scope(request: Request, call_next):
    raw = request.scope.get("raw_path", b"")
    path = request.scope.get("path", "")
    print(f"  raw_path bytes : {raw}")
    print(f"  raw_path str   : {raw.decode('latin-1')}")
    print(f"  scope path     : {path}")
    print(f"  request.url    : {request.url}")
    return await call_next(request)

@debug_app.get("/api/v1/users/me")
async def users_me():
    return {"route": "users/me"}

@debug_app.get("/api/v1/agents/{id}")
async def agents_id(id: str):
    return {"route": "agents", "id": id}

async def main():
    async with AsyncClient(transport=ASGITransport(app=debug_app), base_url="http://test") as c:
        for evil in ["../users/me", "..%2Fusers%2Fme", "%2e%2e/agents"]:
            print(f"\n--- GET /api/v1/agents/{evil} ---")
            r = await c.get(f"/api/v1/agents/{evil}")
            print(f"  status: {r.status_code}  body: {r.text[:80]}")

asyncio.run(main())
