    @pytest.mark.asyncio
    async def test_circular_manifest_rejected(self, client: AsyncClient, headers: dict):
        """Deeply nested manifest (200 levels) must be rejected by depth validator (422)."""
        deeply_nested = {}
        current = deeply_nested
        for _ in range(200):
            current["a"] = {}
            current = current["a"]

        resp = await client.post(
            "/api/v1/skills/publish",
            json={
                "name": "Deep Nested",
                "slug": "deep-nested-manifest",
                "description": "x",
                "category": "utility",
                "manifest": deeply_nested,
            },
            headers=headers,
        )
        # Depth validator rejects it before it reaches DB → 422
        assert resp.status_code == 422
        assert "depth" in resp.json()["detail"][0]["msg"].lower()
