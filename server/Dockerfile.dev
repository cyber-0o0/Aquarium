FROM python:3.12-slim

# Use pre-built uv binary to avoid pip network issues during build
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only what is strictly necessary to install dependencies
COPY pyproject.toml uv.lock* README.md ./

# We create a dummy app package folder to satisfy 'pip install .' if it looks for packages
RUN mkdir -p app
RUN touch app/__init__.py

# Install dependencies into system python using uv
# --system flag tells uv to use the system python environment
RUN uv pip install --system -e .
RUN uv pip install --system watchdog

# Clean dummy folder since source will be mounted as volume
RUN rm -rf app

EXPOSE 8000
ENV DEBUG=true

CMD ["python", "main.py"]
